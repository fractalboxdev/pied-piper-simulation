# Copy to `.env` and fill in values — `pnpm seed:*` scripts inject it via
# dotenvx (`dotenvx run -- ...`). Plaintext works out of the box; optionally
# encrypt values in place with `dotenvx set KEY value` (private key lands in
# .env.keys — gitignored, never commit it).

# Slack sandbox seeding (scripts/slack/seed-personas.ts)
# Bot token (xoxb-...) from a Slack app installed into a Slack Developer Program
# sandbox workspace — see the header of scripts/slack/seed-personas.ts for the
# app manifest and required scopes. Never commit real values.
SLACK_BOT_TOKEN=
# Target channel: name or channel ID (C...). Defaults to #pied-piper if unset.
# NB: don't use a leading "#" in the value — Node's env-file parser treats it
# as a comment ("general", not "#general").
SLACK_CHANNEL=

# --- Real persona accounts (optional; scripts/slack/collect-user-tokens.ts +
# --- setup-profiles.ts). App "Basic Information" credentials + a registered
# --- HTTPS redirect URL; see the collect-user-tokens.ts header.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URL=
# Email-hint domain for persona logins (pied-piper-sim-<slug>@<domain>).
PERSONA_EMAIL_DOMAIN=debuggingfuture.com
# Per-persona user tokens — appended automatically by `pnpm slack:user-tokens`.
#SLACK_USER_TOKEN_RICHARD=
#SLACK_USER_TOKEN_JARED=
#SLACK_USER_TOKEN_GILFOYLE=
#SLACK_USER_TOKEN_DINESH=
#SLACK_USER_TOKEN_ERLICH=
#SLACK_USER_TOKEN_MONICA=
#SLACK_USER_TOKEN_JIANYANG=
#SLACK_USER_TOKEN_BIGHEAD=

# HubSpot fixture seeding (scripts/hubspot/seed-fixtures.ts)
# Private app access token (pat-...) from a HubSpot *developer test account* —
# see the header of scripts/hubspot/seed-fixtures.ts for required scopes.
HUBSPOT_PRIVATE_APP_TOKEN=

# PostHog fixture seeding (scripts/posthog/seed-fixtures.ts)
# Project API key (phc_...) — public/write-only, but still env-injected.
POSTHOG_PROJECT_API_KEY=
# Ingestion host; defaults to https://us.i.posthog.com (EU: https://eu.i.posthog.com).
POSTHOG_HOST=

# Stripe revenue seeding (scripts/stripe/seed-fixtures.ts)
# TEST-MODE secret key only (sk_test_...) — the script refuses live keys.
STRIPE_SECRET_KEY=
# Optional: remap the sim_time → test-clock offset if your account rejects
# far-past frozen times / meter timestamps (ISO 8601, e.g. 2026-06-01T00:00:00Z).
STRIPE_TEST_CLOCK_EPOCH=
